# Copie para .env e preencha com valores locais. Nunca commite .env.
# Portas canônicas: API 8082 · MySQL host 3307 (Agentes/PORTFOLIO-PORTS.md)

MYSQL_PASSWORD=troque-por-uma-senha-local
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-local

DB_URL=jdbc:mysql://localhost:3307/facelogai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=facelogai
DB_PASSWORD=troque-por-uma-senha-local

JWT_SECRET_BASE64=gere-com-openssl-rand-base64-32

FACELOGAI_SEED_ADMIN_ENABLED=false
FACELOGAI_SEED_ADMIN_EMAIL=admin@facelogai.local
FACELOGAI_SEED_ADMIN_PASSWORD=troque-por-uma-senha-local-forte
